{
  "framework": "nextjs",
  "installCommand": "npm install --package-lock=false --ignore-scripts && npm --prefix web_dashboard ci",
  "buildCommand": "npm --prefix web_dashboard run build",
  "outputDirectory": "web_dashboard/.next",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    }
  ]
}
